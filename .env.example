# Copy this file to ".env" (same folder) and fill in your key to enable a
# real LLM for "Ask MANTHAN" chat instead of the offline template system.
# Without this file / without a key, the app still works fully — it just
# uses the built-in offline responses.
#
# SECURITY: this is a browser-only app (no backend). Any key here is bundled
# into the shipped JS and visible to anyone who opens dev tools on the built
# site. Fine for a hackathon/judged demo with a scoped, low-limit key — do
# NOT reuse a production key, and rotate it after the demo.

# One of: anthropic | openai | google
VITE_LLM_PROVIDER=anthropic

# Your API key for the chosen provider.
VITE_LLM_API_KEY=

# Optional: override the default model.
# anthropic default: claude-sonnet-5   (fast/cheap alt: claude-haiku-4-5-20251001)
# openai default:    gpt-4o-mini
# google default:    gemini-2.0-flash
VITE_LLM_MODEL=
